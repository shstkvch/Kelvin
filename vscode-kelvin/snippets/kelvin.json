{
  "App": {
    "prefix": "app",
    "body": [
      "app ${1:AppName} {",
      "  config {",
      "    accent: '${2:#3B82F6}'",
      "  }",
      "  ",
      "  $0",
      "}"
    ],
    "description": "Create a new Kelvin app"
  },
  "Entity": {
    "prefix": "entity",
    "body": [
      "entity ${1:EntityName} {",
      "  ${2:field}: ${3:text(1..100)}",
      "  $0",
      "}"
    ],
    "description": "Create a new entity"
  },
  "Entity with User": {
    "prefix": "entity-user",
    "body": [
      "entity User {",
      "  email: email",
      "  name: text(1..100)",
      "  role: enum('${1:user}', '${2:admin}') = '${1:user}'",
      "}"
    ],
    "description": "Create a User entity with authentication fields"
  },
  "View": {
    "prefix": "view",
    "body": [
      "view ${1:view_name} {",
      "  ${2:visibility: public}",
      "  ",
      "  list ${3:Entity} {",
      "    show: ${4:*}",
      "    ${5:order by: created desc}",
      "    ${6:actions: edit, delete}",
      "  }",
      "  $0",
      "}"
    ],
    "description": "Create a new view"
  },
  "View with Require": {
    "prefix": "view-require",
    "body": [
      "view ${1:admin} {",
      "  require: ${2:role == 'admin'}",
      "  ",
      "  list ${3:Entity} {",
      "    show: ${4:*}",
      "    actions: edit, delete",
      "  }",
      "  $0",
      "}"
    ],
    "description": "Create a view with require block"
  },
  "List": {
    "prefix": "list",
    "body": [
      "list ${1:Entity} {",
      "  show: ${2:*}",
      "  ${3:where: ${4:condition}}",
      "  ${5:order by: ${6:created desc}}",
      "  ${7:filter by: ${8:field}}",
      "  ${9:actions: ${10:edit, delete}}",
      "}"
    ],
    "description": "Create a list block"
  },
  "Detail": {
    "prefix": "detail",
    "body": [
      "detail ${1:Entity} as ${2:entity} {",
      "  show: ${3:*}",
      "  ${4:where: ${5:condition}}",
      "  ",
      "  $0",
      "}"
    ],
    "description": "Create a detail block"
  },
  "Create": {
    "prefix": "create",
    "body": [
      "create ${1:Entity} as ${2:entity} {",
      "  input: ${3:field1, field2}",
      "  ",
      "  then {",
      "    ${2:entity}.${4:field} = ${5:value}",
      "    $0",
      "  }",
      "}"
    ],
    "description": "Create a create block"
  },
  "Edit": {
    "prefix": "edit",
    "body": [
      "edit ${1:Entity} as ${2:entity} {",
      "  ${3:require: ${4:condition}}",
      "  input: ${5:field1, field2}",
      "}"
    ],
    "description": "Create an edit block"
  },
  "Action": {
    "prefix": "action",
    "body": [
      "action ${1:action_name}(${2:entity}: ${3:Entity}) {",
      "  ${4:require: ${5:condition}}",
      "  ",
      "  then {",
      "    ${2:entity}.${6:status} = '${7:value}'",
      "    $0",
      "  }",
      "}"
    ],
    "description": "Create a custom action"
  },
  "Action with Trigger": {
    "prefix": "action-trigger",
    "body": [
      "action ${1:action_name}(${2:entity}: ${3:Entity}) {",
      "  require: ${4:condition}",
      "  ",
      "  then {",
      "    ${2:entity}.${5:status} = '${6:value}'",
      "    trigger('${7:trigger_name}', ${2:entity})",
      "  }",
      "}"
    ],
    "description": "Create an action with trigger"
  },
  "Require Block": {
    "prefix": "require",
    "body": [
      "require {",
      "  ${1:condition}",
      "  ${2:condition}",
      "}"
    ],
    "description": "Create a require block"
  },
  "Then Block": {
    "prefix": "then",
    "body": [
      "then {",
      "  ${1:entity}.${2:field} = ${3:value}",
      "  $0",
      "}"
    ],
    "description": "Create a then block"
  },
  "Where Block": {
    "prefix": "where",
    "body": [
      "where {",
      "  ${1:condition}",
      "  ${2:condition}",
      "}"
    ],
    "description": "Create a where block"
  },
  "Field - Text": {
    "prefix": "field-text",
    "body": "${1:name}: text(${2:1}..${3:100})${4:?}",
    "description": "Add a text field"
  },
  "Field - Email": {
    "prefix": "field-email",
    "body": "${1:email}: email",
    "description": "Add an email field"
  },
  "Field - Int": {
    "prefix": "field-int",
    "body": "${1:count}: int(${2:0}..${3:})${4: = ${5:0}}",
    "description": "Add an integer field"
  },
  "Field - Money": {
    "prefix": "field-money",
    "body": "${1:price}: money",
    "description": "Add a money field"
  },
  "Field - Bool": {
    "prefix": "field-bool",
    "body": "${1:active}: bool = ${2:true}",
    "description": "Add a boolean field"
  },
  "Field - Enum": {
    "prefix": "field-enum",
    "body": "${1:status}: enum('${2:draft}', '${3:published}') = '${2:draft}'",
    "description": "Add an enum field"
  },
  "Field - Date": {
    "prefix": "field-date",
    "body": "${1:date}: date",
    "description": "Add a date field"
  },
  "Field - Timestamp": {
    "prefix": "field-timestamp",
    "body": "${1:created}: timestamp = now()",
    "description": "Add a timestamp field with default"
  },
  "Field - Belongs To": {
    "prefix": "field-belongs",
    "body": "${1:author}: ${2:User}${3:?}",
    "description": "Add a belongs-to relationship"
  },
  "Field - Has Many": {
    "prefix": "field-hasmany",
    "body": "${1:posts}: [${2:Post}]${3: via ${4:author}}",
    "description": "Add a has-many relationship"
  },
  "Validate": {
    "prefix": "validate",
    "body": "validate ${1:end_date} >= ${2:start_date}",
    "description": "Add a validation rule"
  },
  "Trigger": {
    "prefix": "trigger",
    "body": "trigger('${1:trigger_name}', ${2:entity})",
    "description": "Add a trigger call"
  }
}
